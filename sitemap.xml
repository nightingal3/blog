---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <lastmod>{% if site.posts.first.updated %}{{ site.posts.first.updated | date_to_xmlschema }}{% else %}{{ site.posts.first.date | date_to_xmlschema }}{% endif %}</lastmod>
  </url>
  <url>
    <loc>{{ '/archive/' | absolute_url }}</loc>
    <lastmod>{% if site.posts.first.updated %}{{ site.posts.first.updated | date_to_xmlschema }}{% else %}{{ site.posts.first.date | date_to_xmlschema }}{% endif %}</lastmod>
  </url>
  <url>
    <loc>{{ '/about/' | absolute_url }}</loc>
  </url>
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{% if post.updated %}{{ post.updated | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</lastmod>
  </url>
  {% endfor %}
</urlset>
